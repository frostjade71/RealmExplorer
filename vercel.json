{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).gif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/minecraft-java-bedrock-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-java-realms",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-realms",
      "destination": "/minecraft-bedrock-realms",
      "permanent": true
    },
    {
      "source": "/minecraft-survival-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-lifesteal-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-earth-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-creative-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-anarchy-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-rpg-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-towny-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-oneblock-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-pixelmon-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-lifesteal-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-bedrock-lifesteal-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-java-lifesteal-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-survival-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-bedrock-survival-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-java-survival-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-anarchy-smp-servers",
      "destination": "/servers",
      "permanent": true
    },
    {
      "source": "/minecraft-realm-list",
      "destination": "/minecraft-bedrock-realms",
      "permanent": true
    },
    {
      "source": "/status",
      "destination": "https://status.realmexplorer.xyz",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "appeals.realmexplorer.xyz"
        }
      ],
      "destination": "https://www.realmexplorer.xyz/appeal",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/og?route=home" },
    {
      "source": "/server/:slug",
      "destination": "/api/og?route=server&slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/api/og?route=projects&slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/og?route=blog&slug=:slug"
    },
    { "source": "/appeal", "destination": "/appeal.html" },
    { "source": "/servers", "destination": "/api/og?route=servers" },
    { "source": "/projects", "destination": "/api/og?route=static&slug=projects" },
    { "source": "/leaderboards", "destination": "/api/og?route=static&slug=leaderboards" },
    { "source": "/blog", "destination": "/api/og?route=static&slug=blog" },
    { "source": "/about", "destination": "/api/og?route=static&slug=about" },
    { "source": "/team", "destination": "/api/og?route=static&slug=team" },
    { "source": "/upgrade", "destination": "/api/og?route=static&slug=upgrade" },
    { "source": "/terms", "destination": "/api/og?route=static&slug=terms" },
    { "source": "/privacy", "destination": "/api/og?route=static&slug=privacy" },
    { "source": "/copyright", "destination": "/api/og?route=static&slug=copyright" },
    { "source": "/pj", "destination": "/api/og?route=static&slug=pj" },
    { "source": "/docs", "destination": "/api/og?route=static&slug=docs" },
    { "source": "/api-docs", "destination": "/api/og?route=static&slug=api-docs" },
    { "source": "/:slug(minecraft-[a-z-]+)", "destination": "/api/og?route=landing&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/servers", "destination": "/api/servers" },
    { "source": "/api/votifier", "destination": "/api/votifier" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
