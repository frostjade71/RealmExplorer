  "rewrites": [
    {
      "source": "/server/:slug",
      "destination": "/api/og?type=server&slug=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/api/og?type=projects&slug=:slug"
    },
    { "source": "/appeal", "destination": "/appeal.html" },
    { "source": "/api-docs", "destination": "/api/og?type=api-docs" },
    { "source": "/api/servers", "destination": "/api/servers" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
